{
  "name": "walnut",
  "private": true,
  "version": "2.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop:compile": "tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "desktop": "npm run build && npm run desktop:compile && electron-builder --win nsis",
    "desktop:mac": "npm run build && npm run desktop:compile && electron-builder --mac dmg",
    "desktop:dev": "npm run build && npm run desktop:compile && electron .",
    "android:sync": "npm run build && node -e \"require('fs').rmSync('dist/Walnut.apk', { force: true })\" && npx cap sync android",
    "release": "node scripts/release.mjs"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "app.walnut.desktop",
    "productName": "Walnut",
    "publish": [
      {
        "provider": "github",
        "owner": "harshadmaneai-dotcom",
        "repo": "walnut-budget"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "artifactName": "Walnut-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "public/icon-512.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
